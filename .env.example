# ---------------------------------------------------------------------------
# FlatMatch environment variables. Copy to .env.local and fill in.
# Never commit real values. .env* files (except this one) are git-ignored.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API). Public, used in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key. Public by design: Row Level Security
# protects the data. Used in the browser and on the server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google Gemini API key (https://aistudio.google.com/apikey). SERVER ONLY.
# Optional: without it FlatMatch shows rule-based explanations and says so.
GEMINI_API_KEY=

# Optional Gemini model override. Default: gemini-2.5-flash
GEMINI_MODEL=

# Optional. "mock" (default) or "authorized_api". The authorized API provider
# is a placeholder for a licensed listings partner and needs the two vars below.
PROPERTY_PROVIDER=mock
PROPERTY_API_URL=
PROPERTY_API_KEY=

# NOT USED. FlatMatch never needs the Supabase service-role key. If you add a
# feature that does, keep it server-only and never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
